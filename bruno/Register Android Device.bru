meta {
  name: Register Android Device
  type: http
  seq: 3
}

post {
  url: {{base_url}}/register
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "device_token": "{{device_token_android}}",
    "platform": "android",
    "bundle_id": "com.aptove.android"
  }
}

docs {
  Register an Android device for push notifications.

  Authentication:
  - Authorization: Bearer <jwt>  (RS256 JWT from cf-token, 1h TTL)

  Required fields:
  - device_token: FCM device token
  - platform: "android"
  - bundle_id: Android package name (optional)

  Response:
  - ok: true
  - message: "Device registered"
}
