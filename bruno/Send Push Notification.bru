meta {
  name: Send Push Notification
  type: http
  seq: 5
}

post {
  url: {{base_url}}/push
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "title": "New Tool Request",
    "body": "Agent wants to execute a tool"
  }
}

docs {
  Send a push notification to all devices registered under this bridge's JWT identity.

  Authentication:
  - Authorization: Bearer <jwt>  (RS256 JWT from cf-token, 1h TTL)
  - The JWT sub claim (client_id) determines which registered devices receive the notification

  Required fields:
  - title: Notification title
  - body: Notification message body

  Response:
  - ok: true
  - results: Array of delivery results per device
    - platform: "ios" | "android"
    - status: "sent" | "failed"
}
