meta {
  name: Register iOS Device
  type: http
  seq: 2
}

post {
  url: {{base_url}}/register
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "device_token": "{{device_token_ios}}",
    "platform": "ios",
    "bundle_id": "com.aptove.ios"
  }
}

docs {
  Register an iOS device for push notifications.

  Authentication:
  - Authorization: Bearer <jwt>  (RS256 JWT from cf-token, 1h TTL)

  Required fields:
  - device_token: APNs device token
  - platform: "ios"
  - bundle_id: iOS app bundle identifier (optional)

  Response:
  - ok: true
  - message: "Device registered"
}
